# Copy to .env (next to eas-local / eas-local.ps1) and fill in — never
# commit the real file.

# Generate at https://expo.dev/accounts/[account]/settings/access-tokens
# Scope it to the minimum needed (this project only) and rotate periodically.
EXPO_TOKEN=

# Optional — set these so you don't have to pass --remote/--key/--remote-dir
# on every run. An explicit --remote/--key flag always overrides these.
EAS_LOCAL_REMOTE_HOST=
EAS_LOCAL_REMOTE_KEY=
EAS_LOCAL_REMOTE_DIR=
